# Copia este archivo a ".env" (sin el ".example") y rellena tus propios
# valores. ".env" nunca se sube a Git — este archivo sí, para que el equipo
# sepa qué variables existen.

MONGO_URI=mongodb://localhost:27017/axioma
JWT_SECRET=reemplaza-esto-con-una-cadena-aleatoria-larga
PORT=4000
CLIENT_ORIGIN=http://localhost:5173
VITE_API_URL=http://localhost:4000
